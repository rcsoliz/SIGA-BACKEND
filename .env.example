# Variables de entorno para correr el backend fuera de appsettings.Development.json
# (uso local apuntando a una BD remota, o como referencia de lo que Render necesita).
# El nombre real que lee ASP.NET Core usa doble guion bajo "__" para anidar secciones.
# NO se carga automáticamente por dotnet run: exportar a mano o usar `--environment-file`
# de tu shell/orquestador preferido.

# Formato Npgsql (NO uses la URI postgresql://host/db que entrega Render).
# Construir a partir del Internal (en Render) o External (para pruebas locales) DB URL:
# Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__SigaDatabase=Host=localhost;Port=5434;Database=siga;Username=siga_user;Password=siga_password

Jwt__Secret=CAMBIAR_ESTE_SECRETO_POR_UNO_DE_AL_MENOS_32_CARACTERES
Jwt__Issuer=SIGA.Api
Jwt__Audience=SIGA.Frontend
Jwt__ExpiracionMinutos=480

# Array: un índice por origen permitido.
Cors__OrigenesPermitidos__0=http://localhost:5173

ASPNETCORE_ENVIRONMENT=Development
